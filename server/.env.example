# Shared secret between the server and the browser extension (at least 24 chars).
# Generate one with: openssl rand -hex 24
BRIDGE_TOKEN=replace_with_output_of_openssl_rand_hex_24

# Plex Media Server settings (used to scan the library and import .m3u playlists)
PLEX_URL=http://10.0.0.69:32400
PLEX_TOKEN=
PLEX_SECTION_ID=3

# Path to the Music folder as Plex sees it on the QNAP NAS
PLEX_MUSIC_ROOT=/share/CACHEDEV1_DATA/Multimedia/Media/Music

# Optional: UID/GID that owns your Music share on the NAS (default 1000:1000).
# On QNAP, run `id admin` or `ls -nd /share/CACHEDEV1_DATA/Multimedia/Media/Music` over SSH to check.
PUID=1000
PGID=1000
